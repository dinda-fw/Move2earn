# =============================================================================
# MOVE2EARN ENVIRONMENT VARIABLES
# Copy to move2earn-web/.env.local and configure your environment
# =============================================================================

# Public Supabase credentials (safe for client-side web & Android)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Demo mode toggle (true = works immediately with rich simulated data if Supabase is unlinked)
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# =============================================================================
# GOOGLE GEMINI AI CONFIGURATION (MoveIt Pro AI Coach Chatbot)
# Dapatkan API Key gratis di Google AI Studio: https://aistudio.google.com/
# =============================================================================
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Service role key (OPTIONAL - only for secure server administrative endpoints, NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
