# =============================================================================
# MOVE2EARN ENVIRONMENT VARIABLES
# Copy to move2earn-web/.env.local and configure your Supabase instance
# =============================================================================

# Public Supabase credentials (safe for client-side web & Android)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Demo mode toggle (true = works immediately with rich simulated data if Supabase is unlinked)
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# Service role key (OPTIONAL - only for secure server administrative endpoints, NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
