# =============================================================================
# MOVE2EARN WEB ENVIRONMENT VARIABLES
# Rename / copy this file to: move2earn-web/.env.local
# =============================================================================

# Public Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Demo mode toggle
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# =============================================================================
# GOOGLE GEMINI AI CONFIGURATION (MoveIt Pro AI Coach Chatbot)
# Dapatkan API Key gratis di Google AI Studio: https://aistudio.google.com/
# Masukkan API Key Anda di bawah ini pada file .env.local:
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
